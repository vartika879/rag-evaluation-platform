  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "0b51566c",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "INFO:app.ingestion.loader:Loaded 67 pages from rag_survey.pdf\n",
      "INFO:httpx:HTTP Request: POST https://api.cohere.com/v1/embed \"HTTP/1.1 200 OK\"\n",
      "INFO:httpx:HTTP Request: POST https://api.cohere.com/v1/embed \"HTTP/1.1 200 OK\"\n",
      "INFO:httpx:HTTP Request: POST https://api.cohere.com/v1/embed \"HTTP/1.1 200 OK\"\n",
      "INFO:app.embeddings.service:Embedded 234 texts in 4.29s\n",
      "INFO:app.vectorstore.qdrant_store:Collection 'rag_documents' created.\n",
      "INFO:app.vectorstore.qdrant_store:Stored 234 points in 'rag_documents'.\n",
