   "outputs": [],
   "source": [
    "run_pipeline(\"What is RAG?\")                                   # baseline (vector search)\n",
    "run_pipeline(\"What is RAG?\", \"hybrid_rerank\")                  # preset ka naam\n",
    "run_pipeline(\"What is RAG?\", {\"retrieval_method\": \"bm25\", \"top_k\": 3})   # dict\n",
    "run_pipeline(\"What is RAG?\", PipelineConfig(use_crag=True))    # object"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0b8de568",
   "metadata": {},
   "outputs": [],
   "source": [
    "from app.pipeline import run_pipeline\n",
    "\n",
    "for preset in [\"vector\", \"hybrid\", \"hybrid_rerank\"]:\n",
    "    t = run_pipeline(\"What is the main challenge in the retriever module?\", preset, run_id=\"smoke\")\n",
    "    print(\"\\n\", t.config_label, \"->\", t.action, \"|\", t.total_latency_ms, \"ms |\", t.usage[\"total_tokens\"], \"tokens\")\n",
    "    for s in t.stages:\n",
    "        print(\"  \", s.name.ljust(16), s.status.ljust(8), s.latency_ms, \"ms\", s.error or \"\")\n",
    "    print(\"  ANSWER:\", t.answer[:150])"
   ]
  },
