   "source": [
    "from app.retrieval.bm25 import retrieve_bm25\n",
    "\n",
    "for q in [\"Annoy approximate nearest neighbor\", \"What is Retrieval-Augmented Generation?\"]:\n",
    "    print(\"\\nQ:\", q)\n",
    "    for r in retrieve_bm25(q, top_k=5):\n",
