   "source": [
    "## retrieval/hybrid.py"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cc92ad03",
   "metadata": {},
   "outputs": [],
   "source": [
    "from app.retrieval.retriever import retrieve_chunks\n",
    "from app.retrieval.bm25 import retrieve_bm25\n",
    "from app.retrieval.hybrid import retrieve_hybrid, overlap_stats\n",
    "\n",
    "q = \"What are the major types of retrieval fusion?\"\n",
    "\n",
    "v = retrieve_chunks(q, top_k=30)\n",
    "b = retrieve_bm25(q, top_k=30)\n",
    "print(\"Overlap:\", overlap_stats(v, b))\n",
    "\n",
    "for method in [\"rrf\", \"weighted\"]:\n",
    "    print(\"\\n\", method)\n",
    "    for r in retrieve_hybrid(q, top_k=5, method=method):\n",
    "        print(r.hybrid_rank, r.chunk_id, r.page_number,\n",
    "              \"vec#\", r.vector_rank, \"bm25#\", r.bm25_rank,\n",
    "              round(r.hybrid_score, 2), r.preview(60))"
   ]
  },
  {
   "cell_type": "markdown",
