   "id": "dd05f101",
   "metadata": {},
   "outputs": [],
   "source": [
    "from app.retrieval.advanced.query_transformer import rewrite_query\n",
    "\n",
    "history = [\n",
    "    {\"role\": \"user\", \"content\": \"What is Retrieval-Augmented Generation?\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"It combines retrieval of external knowledge with an LLM.\"},\n",
    "]\n",
    "\n",
    "r = rewrite_query(\"What are its main challenges?\", history)\n",
    "print(r[\"query\"], \"|\", r[\"changed\"], r[\"fallback_reason\"], r[\"latency_ms\"], \"ms\")\n",
    "\n",
    "r2 = rewrite_query(\"What is RAG?\")   # bina history\n",
    "print(r2[\"query\"], r2[\"llm_called\"], r2[\"fallback_reason\"])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b52897ca",
   "metadata": {},
   "source": [
    "## query_expansion.py aur multi_query.py"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "19536418",
   "metadata": {},
   "outputs": [],
   "source": [
    "from app.retrieval.advanced.query_expansion import expand_query_detailed\n",
    "from app.retrieval.advanced.multi_query import generate_query_variants, retrieve_multi_query\n",
    "\n",
    "q = \"What are the major types of retrieval fusion?\"\n",
    "\n",
    "e = expand_query_detailed(q)\n",
    "print(\"EXPANDED:\", e[\"query\"], \"| terms:\", e[\"added_terms\"], e[\"fallback_reason\"])\n",
    "\n",
    "info = generate_query_variants(q, num_queries=3)\n",
    "print(\"\\nQUERIES:\")\n",
    "for text in info[\"queries\"]:\n",
    "    print(\" -\", text)\n",
    "\n",
    "print(\"\\nFUSED RESULTS:\")\n",
    "for r in retrieve_multi_query(q, top_k=5, variants=info[\"queries\"]):\n",
    "    print(r.hybrid_rank, r.chunk_id, r.page_number, round(r.hybrid_score, 2), r.preview(60))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "efd31529",
   "metadata": {},
   "source": [
    "## retrieval/advanced/hyde.py"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e514ad4c",
   "metadata": {},
   "outputs": [],
   "source": [
    "from app.retrieval.advanced.hyde import create_hyde_vector, retrieve_hyde\n",
    "from app.retrieval.retriever import retrieve_chunks\n",
    "\n",
    "q = \"What is the main challenge in the retriever module?\"\n",
    "\n",
    "h = create_hyde_vector(q)\n",
    "print(\"PASSAGE:\", h[\"hypothetical_document\"])\n",
    "print(h[\"vector_dim\"], h[\"embed_as\"], h[\"fallback_reason\"], h[\"latency_ms\"], \"ms\", h[\"usage\"])\n",
    "\n",
    "print(\"\\nPLAIN VECTOR SEARCH\")\n",
    "for r in retrieve_chunks(q, top_k=5):\n",
    "    print(r.vector_rank, r.chunk_id, r.page_number, round(r.score, 3), r.preview(60))\n",
    "\n",
    "print(\"\\nHYDE SEARCH\")\n",
    "for r in retrieve_hyde(q, top_k=5, hyde=h):\n",
    "    print(r.vector_rank, r.chunk_id, r.page_number, round(r.score, 3), r.preview(60))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c563a431",
   "metadata": {},
   "source": [
    "## crag.py aur context_compressor.py"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "93209e73",
   "metadata": {},
   "outputs": [],
   "source": [
    "from app.retrieval.hybrid import retrieve_hybrid\n",
    "from app.retrieval.advanced.crag import run_crag\n",
    "from app.retrieval.advanced.context_compressor import compress_context_detailed\n",
    "\n",
    "questions = [\n",
    "    \"What is the main challenge in the retriever module?\",   # answerable\n",
    "    \"Who is the current Prime Minister of India?\",           # unanswerable\n",
    "]\n",
    "\n",
    "for q in questions:\n",
    "    chunks = retrieve_hybrid(q, top_k=5)\n",
    "    out = run_crag(q, chunks, top_k=5)\n",
    "    print(\"\\nQ:\", q)\n",
    "    print(\"action:\", out[\"action\"], \"| llm_calls:\", out[\"llm_calls\"])\n",
    "    for g in out[\"grades\"]:\n",
    "        print(\"  grade:\", g[\"verdict\"], \"-\", g[\"reason\"])\n",
    "\n",
    "    c = compress_context_detailed(q, out[\"chunks\"], min_chars=0)\n",
    "    print(\"  compression ratio:\", c[\"ratio\"], [p[\"status\"] for p in c[\"per_chunk\"]], c[\"fallback_reason\"])"
   ]
  },
