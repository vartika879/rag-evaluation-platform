  {
   "cell_type": "markdown",
   "id": "07dee00a",
   "metadata": {},
   "source": [
    "Step 20: Trace (record book)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c0ed98ce",
   "metadata": {},
   "outputs": [],
   "source": [
    "trace = Trace.new(question, config)\n",
    "\n",
    "with trace.stage(\"retrieve\", method=\"hybrid\") as stage:\n",
    "    chunks = retrieve_hybrid(...)\n",
    "    stage.details[\"count\"] = len(chunks)      # time apne aap naap jaata hai"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e1674753",
   "metadata": {},
   "source": [
    "Ab tak ka picture: Phase 4 mein ye sab kaise judega\n",
    "PipelineConfig  ──►  pipeline.py  ──►  Trace (har stage ka record)\n",
    " (kya chalana hai)   (chalata hai)         │\n",
    "                                           ▼\n",
    "                                      trace_store.py  ──►  dashboard / eval\n",
    "                                      (disk pe save)\n",
    "Check karne ke liye (30 second, koi API nahi chahiye)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7a7f0750",
   "metadata": {},
   "outputs": [],
   "source": [
    "from app.pipeline_config import get_preset, PipelineConfig\n",
    "from app.tracing.trace import Trace\n",
    "\n",
    "cfg = get_preset(\"hybrid_rerank\", top_k=3)\n",
    "print(cfg.label(), cfg.fingerprint())\n",
    "print(cfg.diff_from(PipelineConfig()))\n",
    "\n",
    "t = Trace.new(\"What is RAG?\", cfg)\n",
    "with t.stage(\"retrieve\", method=\"hybrid\") as s:\n",
    "    s.details[\"count\"] = 5\n",
    "print(t.finish().to_json()[:500])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "096f2317",
   "metadata": {},
   "source": [
    "21. tracing/trace_store.py"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6de95a9f",
   "metadata": {},
   "outputs": [],
   "source": [
    "from app.pipeline_config import get_preset\n",
    "from app.tracing.trace import Trace\n",
    "from app.tracing.trace_store import get_store, save_trace\n",
    "\n",
    "cfg = get_preset(\"hybrid_rerank\")\n",
    "t = Trace.new(\"What is RAG?\", cfg)\n",
    "with t.stage(\"retrieve\") as s:\n",
    "    s.details[\"count\"] = 5\n",
    "t.answer, t.action = \"RAG combines retrieval and generation.\", \"answered\"\n",
    "t.finish()\n",
    "\n",
    "print(save_trace(t, run_id=\"demo\"))                 # True\n",
    "store = get_store()\n",
    "print(store.list(limit=3))\n",
    "print(store.stats(run_id=\"demo\"))\n",
    "print(store.get(t.trace_id).stages[0].name)         # retrieve\n",
    "print(store.path)                                   # data/traces/traces.db"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fc634125",
   "metadata": {},
   "source": [
